@model eHoteloo.Models.Booking
@{
    ViewData["Title"] = "Booking Confirmed";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0 text-center">
                <div class="card-body p-5">
                    <div class="mb-4">
                        <div class="success-checkmark">
                            <i class="bi bi-check-circle-fill display-1 text-success"></i>
                        </div>
                    </div>
                    <h2 class="fw-bold mb-3">Booking Confirmed!</h2>
                    <p class="text-muted mb-4">Your reservation has been successfully processed.</p>

                    <div class="bg-light rounded p-4 mb-4 text-start">
                        <div class="row g-3">
                            <div class="col-6">
                                <p class="text-muted small mb-1">Booking Number</p>
                                <p class="fw-bold mb-0">@Model.BookingNumber</p>
                            </div>
                            <div class="col-6">
                                <p class="text-muted small mb-1">Status</p>
                                <span class="badge bg-success">@Model.Status</span>
                            </div>
                            <div class="col-6">
                                <p class="text-muted small mb-1">Check-In</p>
                                <p class="fw-bold mb-0">@Model.CheckIn.ToString("MMM dd, yyyy")</p>
                            </div>
                            <div class="col-6">
                                <p class="text-muted small mb-1">Check-Out</p>
                                <p class="fw-bold mb-0">@Model.CheckOut.ToString("MMM dd, yyyy")</p>
                            </div>
                            <div class="col-6">
                                <p class="text-muted small mb-1">Duration</p>
                                <p class="fw-bold mb-0">@Model.Days night@(Model.Days != 1 ? "s" : "")</p>
                            </div>
                            <div class="col-6">
                                <p class="text-muted small mb-1">Total Paid</p>
                                <p class="fw-bold text-success mb-0">$@Model.BookingPrice.ToString("F2")</p>
                            </div>
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <a asp-action="BookingHistory" asp-controller="Home" asp-area="User" class="btn btn-primary">
                            <i class="bi bi-journal-text"></i> View My Bookings
                        </a>
                        <a asp-action="Index" asp-controller="Home" class="btn btn-outline-secondary">
                            <i class="bi bi-house"></i> Back to Home
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>