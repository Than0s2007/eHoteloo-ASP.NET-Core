@{
    ViewData["Title"] = "Reset Link Sent";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - eHoteloo</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: #f4f6fb;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .container {
            text-align: center;
            max-width: 420px;
            background: #fff;
            border-radius: 20px;
            padding: 48px 40px;
            box-shadow: 0 4px 24px rgba(0,0,0,0.06);
        }

        .icon {
            width: 72px;
            height: 72px;
            background: #eef2ff;
            color: #3b6ff0;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 24px;
        }

            .icon .material-symbols-outlined {
                font-size: 36px;
            }

        h1 {
            font-size: 1.5rem;
            font-weight: 700;
            color: #1a1f36;
            margin-bottom: 12px;
        }

        p {
            color: #6b7a99;
            font-size: 0.95rem;
            line-height: 1.6;
            margin-bottom: 28px;
        }

        .btn {
            display: inline-block;
            padding: 12px 28px;
            background: #3b6ff0;
            color: #fff;
            text-decoration: none;
            border-radius: 10px;
            font-weight: 600;
            font-size: 0.9rem;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="icon">
            <span class="material-symbols-outlined">mail</span>
        </div>
        <h1>Check Your Email</h1>
        <p>If an account exists with that email, we've sent a password reset link. Please check your inbox.</p>
        <a asp-action="Login" class="btn">Back to Login</a>
    </div>
</body>
</html>