@model UpdateServiceStatusViewModel
@{
    ViewData["Title"] = "Update Service Status";
}

<div class="container mt-4">
    <h2 class="mb-4">Update Service Status</h2>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Service Details</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Guest Name</label>
                        <p class="form-control-plaintext">@Model.GuestName</p>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Service Name</label>
                        <p class="form-control-plaintext">@Model.ServiceName</p>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Notes))
                    {
                        <div class="mb-3">
                            <label class="form-label fw-bold">Notes</label>
                            <p class="form-control-plaintext text-muted">@Model.Notes</p>
                        </div>
                    }

                    <form asp-area="Staff" asp-controller="Services" asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="GuestName" />
                        <input type="hidden" asp-for="ServiceName" />
                        <input type="hidden" asp-for="Notes" />

                        <div class="mb-3">
                            <label asp-for="CurrentStatus" class="form-label fw-bold"></label>
                            <select asp-for="CurrentStatus" asp-items="Html.GetEnumSelectList<ServiceStatus>()" class="form-select"></select>
                            <span asp-validation-for="CurrentStatus" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-area="Staff" asp-controller="Services" asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
                            <button type="submit" class="btn btn-success">Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}