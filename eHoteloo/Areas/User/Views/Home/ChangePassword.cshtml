@{
    Layout = "/Views/Shared/_UserLayout.cshtml";
    ViewData["Title"] = "Change Password";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-5">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-white py-4 border-bottom">
                    <h4 class="mb-0 fw-bold"><i class="bi bi-shield-lock me-2"></i>Change Password</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="ChangePassword" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Current Password</label>
                            <input type="password" name="oldPassword" class="form-control form-control-lg rounded-3"
                                   required placeholder="Enter current password" />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">New Password</label>
                            <input type="password" name="newPassword" class="form-control form-control-lg rounded-3"
                                   required placeholder="Enter new password" minlength="6" />
                            <div class="form-text">Minimum 6 characters</div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg rounded-3">
                                <i class="bi bi-check-lg me-2"></i>Update Password
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-3">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>