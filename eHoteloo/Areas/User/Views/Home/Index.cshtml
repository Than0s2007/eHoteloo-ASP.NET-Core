@{
    Layout = "/Views/Shared/_UserLayout.cshtml";
    ViewData["Title"] = "My Profile";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model eHoteloo.VM.UserProfileVM
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-x-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg rounded-4 overflow-hidden">
                <div class="card-header bg-primary text-white py-4">
                    <h3 class="mb-0"><i class="bi bi-person-circle me-2"></i>My Profile</h3>
                </div>
                <div class="card-body p-5">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <div class="row align-items-center mb-4">
                        <div class="col-md-3 text-center">
                            @if (!string.IsNullOrEmpty(Model.IdentityPhotoName))
                            {
                                <img src="~/images/IdentityImage/@Model.IdentityPhotoName"
                                     class="rounded-circle img-thumbnail shadow"
                                     style="width:120px;height:120px;object-fit:cover;" />
                            }
                            else
                            {
                                <div class="rounded-circle bg-secondary d-inline-flex align-items-center justify-content-center text-white"
                                     style="width:120px;height:120px;font-size:48px;">
                                    @(Model.FirstName?[0])
                                </div>
                            }
                        </div>
                        <div class="col-md-9">
                            <h4 class="fw-bold">@Model.FirstName @Model.LastName</h4>
                            <p class="text-muted mb-1"><i class="bi bi-envelope me-2"></i>@Model.Email</p>
                            <p class="text-muted mb-1"><i class="bi bi-telephone me-2"></i>@Model.PhoneNumber</p>
                            <div class="mt-2">
                                @if (Model.IdentityVerified)
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Identity Verified</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark"><i class="bi bi-exclamation-circle me-1"></i>Not Verified</span>
                                }
                            </div>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3">
                                <small class="text-muted text-uppercase fw-bold">Balance</small>
                                <h4 class="text-primary mb-0">$@Model.Balance.ToString("N2")</h4>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3">
                                <small class="text-muted text-uppercase fw-bold">Account Status</small>
                                <h4 class="text-success mb-0">Active</h4>
                            </div>
                        </div>
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <a asp-action="Edit" class="btn btn-outline-primary rounded-3">
                            <i class="bi bi-pencil-square me-2"></i>Edit Profile
                        </a>
                        <a asp-action="BookingHistory" class="btn btn-outline-dark rounded-3">
                            <i class="bi bi-calendar-check me-2"></i>My Bookings
                        </a>
                        <div class="row g-2">
                            <div class="col-6">
                                <a asp-action="ChangeEmail" class="btn btn-outline-secondary w-100 rounded-3">
                                    <i class="bi bi-envelope-at me-2"></i>Change Email
                                </a>
                            </div>
                            <div class="col-6">
                                <a asp-action="ChangePassword" class="btn btn-outline-secondary w-100 rounded-3">
                                    <i class="bi bi-shield-lock me-2"></i>Change Password
                                </a>
                            </div>
                        </div>
                        <form asp-action="Logout" method="post" class="d-grid">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger rounded-3">
                                <i class="bi bi-box-arrow-right me-2"></i>Logout
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>