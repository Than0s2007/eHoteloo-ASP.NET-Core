@using eHoteloo.Models
@{
    Layout = "/Views/Shared/_UserLayout.cshtml";
    ViewData["Title"] = "Booking History";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model List<eHoteloo.Models.Booking>

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3><i class="bi bi-calendar-week me-2"></i>Booking History</h3>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-3">
            <i class="bi bi-arrow-left me-1"></i>Back to Profile
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body text-center py-5">
                <i class="bi bi-inbox display-1 text-muted"></i>
                <h5 class="mt-3 text-muted">No bookings found</h5>
                <p class="text-muted">You haven't made any reservations yet.</p>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var booking in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm rounded-4 hover-shadow transition-all">
                        <div class="position-relative">
                            @if (booking.Room?.Images?.Any() == true)
                            {
                                <img src="@booking.Room.Images.First().ImagePath" 
                                     class="card-img-top rounded-top-4" 
                                     style="height:180px;object-fit:cover;" 
                                     alt="Room Image" />
                            }
                            else
                            {
                                <div class="bg-light d-flex align-items-center justify-content-center rounded-top-4" 
                                     style="height:180px;">
                                    <i class="bi bi-image display-4 text-muted"></i>
                                </div>
                            }
                            <span class="position-absolute top-0 end-0 m-2 badge rounded-pill bg-@(booking.Status switch {
                                BookingStatus.Pending => "warning text-dark",
                                BookingStatus.Confirmed => "info",
                                BookingStatus.CheckedIn => "success",
                                BookingStatus.CheckedOut => "secondary",
                                BookingStatus.Cancelled => "danger",
                                _ => "light"
                            })">
                                @booking.Status
                            </span>
                        </div>
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title fw-bold mb-0">#@booking.BookingNumber</h5>
                                <small class="text-muted">@booking.Days days</small>
                            </div>
                            <p class="text-muted mb-2">
                                <i class="bi bi-door-open me-1"></i>@(booking.Room?.RoomNumber ?? "N/A") - @(booking.Room?.RoomType)
                            </p>
                            <div class="small text-muted mb-3">
                                <div><i class="bi bi-calendar-check me-1"></i>Check-in: @booking.CheckIn.ToString("dd MMM yyyy")</div>
                                <div><i class="bi bi-calendar-x me-1"></i>Check-out: @booking.CheckOut.ToString("dd MMM yyyy")</div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="fw-bold text-primary">$@booking.BookingPrice.ToString("N2")</span>
                                <div class="small text-muted">
                                    <span class="me-2" title="Payments"><i class="bi bi-credit-card me-1"></i>@booking.Payments?.Count</span>
                                    <span title="Services"><i class="bi bi-cone-striped me-1"></i>@booking.Services?.Count</span>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer bg-transparent border-0 pb-3 px-3">
                            <a asp-action="BookingDetails" asp-route-id="@booking.Id" 
                               class="btn btn-primary w-100 rounded-3">
                                View Details
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>