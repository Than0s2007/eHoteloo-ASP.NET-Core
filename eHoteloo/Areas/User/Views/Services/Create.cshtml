@using eHoteloo.Areas.User.ViewModels
@model CreateServiceViewModel
@{
    ViewData["Title"] = "Request Service";
}

<div class="container mt-4">
    <h2 class="mb-4">Request a New Service</h2>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Service Request Form</h5>
                </div>
                <div class="card-body">
                    <form asp-area="User" asp-controller="Services" asp-action="Create" method="post">
                        <input type="hidden" asp-for="BookingId" />

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-bold"></label>
                            <input asp-for="Title" class="form-control" placeholder="e.g. Room Cleaning, Laundry..." />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-bold"></label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Any special instructions..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Price" class="form-label fw-bold"></label>
                            <input asp-for="Price" class="form-control" type="number" step="0.01" placeholder="0.00" />
                            <span asp-validation-for="Price" class="text-danger"></span>
                            <div class="form-text">Enter expected price or estimated cost.</div>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-area="User" asp-controller="Services" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-success">Submit Request</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}