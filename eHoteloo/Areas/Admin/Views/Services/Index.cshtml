@using eHoteloo.Models
@model IEnumerable<eHoteloo.Models.Service>
@{
    Layout = "/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "All Services";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<div class="page-header">
    <h1>All Services</h1>
    <span class="page-date">@DateTime.Now.ToString("dd MMM yyyy")</span>
</div>

<div class="table-card">
    <div class="table-wrapper">
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Title</th>
                    <th>Booking #</th>
                    <th>Guest</th>
                    <th>Price</th>
                    <th>Status</th>
                    <th>Payment</th>
                    <th style="text-align:right;">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var service in Model)
                {
                    <tr>
                        <td class="td-mono">#@service.Id</td>
                        <td style="font-weight:600;">@service.Title</td>
                        <td>@service.Booking?.BookingNumber</td>
                        <td class="td-muted">@service.Booking?.User?.Email</td>
                        <td style="font-weight:700;">$@service.Price</td>
                        <td>
                            @{
                                var badgeClass = service.Status switch
                                {
                                    ServiceStatus.Completed => "badge-green",
                                    ServiceStatus.InProgress => "badge-green",
                                    ServiceStatus.Pending => "badge-yellow",
                                    ServiceStatus.Cancelled => "badge-red",
                                    _ => "badge-gray"
                                };
                            }
                            <span class="badge @badgeClass">@service.Status</span>
                        </td>
                        <td>
                            @if (service.PaymentId.HasValue)
                            {
                                <span style="font-size:0.78rem;color:#15803d;font-weight:600;">Paid (#@service.PaymentId)</span>
                            }
                            else
                            {
                                <span style="font-size:0.78rem;color:var(--color-text-light);">Unpaid</span>
                            }
                        </td>
                        <td style="text-align:right;">
                            <a asp-action="Details" asp-route-id="@service.Id" style="color:var(--color-primary);font-weight:600;font-size:0.82rem;">Details</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>