@using eHoteloo.Models
@model eHoteloo.Models.Payment
@{
    Layout = "/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Payment Details";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<div class="page-header">
    <div style="display:flex;align-items:center;gap:12px;">
        <a asp-action="Index" style="color:var(--color-text-muted);">
            <span class="material-symbols-outlined">arrow_back</span>
        </a>
        <h1>Payment #@Model.Id</h1>
    </div>
</div>

<div style="max-width:600px;background:var(--color-white);border-radius:var(--radius);border:1px solid var(--color-border);padding:28px;">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;font-size:0.9rem;">
        <div>
            <div class="td-muted" style="margin-bottom:4px;">Booking</div>
            <div style="font-weight:700;">@Model.Booking?.BookingNumber</div>
        </div>
        <div>
            <div class="td-muted" style="margin-bottom:4px;">Guest</div>
            <div style="font-weight:600;">@Model.Booking?.User?.Email</div>
        </div>
        <div>
            <div class="td-muted" style="margin-bottom:4px;">Amount</div>
            <div style="font-weight:800;color:#15803d;font-size:1.3rem;">$@Model.Amount</div>
        </div>
        <div>
            <div class="td-muted" style="margin-bottom:4px;">Method</div>
            <div style="font-weight:600;">@Model.Method</div>
        </div>
        <div>
            <div class="td-muted" style="margin-bottom:4px;">Status</div>
            @{
                var badgeClass = Model.Status switch
                {
                    PaymentStatus.Success => "badge-green",
                    PaymentStatus.Pending => "badge-yellow",
                    PaymentStatus.Failed => "badge-red",
                    _ => "badge-gray"
                };
            }
            <span class="badge @badgeClass">@Model.Status</span>
        </div>
        <div>
            <div class="td-muted" style="margin-bottom:4px;">Paid At</div>
            <div style="font-weight:600;">@Model.PaidAt.ToString("dd MMM yyyy HH:mm")</div>
        </div>
    </div>

    @if (Model.Services?.Any() == true)
    {
        <div style="border-top:1px solid var(--color-border);margin-top:24px;padding-top:20px;">
            <h3 style="font-size:1rem;font-weight:700;margin-bottom:12px;">Related Services</h3>
            <div style="display:flex;flex-direction:column;gap:8px;">
                @foreach (var service in Model.Services)
                {
                    <div style="display:flex;justify-content:space-between;padding:8px 12px;background:#f8fafc;border-radius:var(--radius-sm);font-size:0.88rem;">
                        <span>@service.Title</span>
                        <span class="td-muted">@service.Status</span>
                    </div>
                }
            </div>
        </div>
    }
</div>