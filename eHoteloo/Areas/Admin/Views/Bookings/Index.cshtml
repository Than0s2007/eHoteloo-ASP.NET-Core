@using eHoteloo.Models
@model IEnumerable<eHoteloo.Models.Booking>
@{
    Layout = "/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "All Bookings";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<div class="page-header">
    <h1>All Bookings</h1>
    <span class="page-date">@DateTime.Now.ToString("dd MMM yyyy")</span>
</div>

<div class="table-card">
    <div class="table-wrapper">
        <table>
            <thead>
                <tr>
                    <th>Booking #</th>
                    <th>Guest</th>
                    <th>Room</th>
                    <th>Check In / Out</th>
                    <th>Price</th>
                    <th>Status</th>
                    <th style="text-align:right;">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var booking in Model)
                {
                    <tr>
                        <td class="td-mono">@booking.BookingNumber</td>
                        <td>
                            <div style="font-weight:600;">@booking.User?.FirstName @booking.User?.LastName</div>
                            <div style="font-size:0.78rem;color:var(--color-text-muted);">@booking.User?.Email</div>
                        </td>
                        <td>@booking.Room?.RoomNumber</td>
                        <td class="td-muted">
                            <div>@booking.CheckIn.ToString("dd MMM")</div>
                            <div>@booking.CheckOut.ToString("dd MMM yyyy")</div>
                        </td>
                        <td style="font-weight:700;">$@booking.BookingPrice</td>
                        <td>
                            @{
                                var badgeClass = booking.Status switch
                                {
                                    BookingStatus.Confirmed => "badge-green",
                                    BookingStatus.Pending => "badge-yellow",
                                    BookingStatus.Cancelled => "badge-red",
                                    BookingStatus.CheckedIn => "badge-green",
                                    BookingStatus.CheckedOut => "badge-gray",
                                    _ => "badge-gray"
                                };
                            }
                            <span class="badge @badgeClass">@booking.Status</span>
                        </td>
                        <td style="text-align:right;">
                            <a asp-action="Details" asp-route-id="@booking.Id" style="color:var(--color-primary);font-weight:600;font-size:0.82rem;">Details</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>