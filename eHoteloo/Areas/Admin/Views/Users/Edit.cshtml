@using eHoteloo.Models
@model eHoteloo.Areas.Admin.Models.AdminUserEditViewModel
@{
    ViewData["Title"] = "User Edit";
    Layout = "/Views/Shared/_AdminLayout.cshtml";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<div class="page-header">
    <div style="display:flex;align-items:center;gap:12px;">
        <a asp-action="Index" style="color:var(--color-text-muted);">
            <span class="material-symbols-outlined">arrow_back</span>
        </a>
        <h1>Edit User</h1>
    </div>
</div>

<div style="max-width:600px;background:var(--color-white);border-radius:var(--radius);border:1px solid var(--color-border);padding:28px;">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />


        <div style="margin-bottom:20px;">
            <label asp-for="CurrentRole" style="display:block;font-size:0.82rem;font-weight:600;color:var(--color-text-muted);margin-bottom:6px;text-transform:uppercase;letter-spacing:0.5px;">Role</label>
            <select asp-for="CurrentRole" asp-items="@(new SelectList(Model.AvailableRoles))" style="width:100%;padding:10px 14px;border:1px solid var(--color-border);border-radius:var(--radius-sm);font-family:inherit;font-size:0.95rem;background:#fff;"></select>
        </div>

        <div style="display:flex;align-items:center;gap:12px;padding:14px;background:#f8fafc;border-radius:var(--radius-sm);margin-bottom:14px;">
            <input asp-for="IsActive" type="checkbox" style="width:20px;height:20px;accent-color:var(--color-primary);flex-shrink:0;" />
            <div>
                <div style="font-weight:600;font-size:0.92rem;color:var(--color-text-main);">Is Active</div>
                <div style="font-size:0.8rem;color:var(--color-text-muted);">User can login and use the system</div>
            </div>
        </div>

        <div style="display:flex;align-items:center;gap:12px;padding:14px;background:#f8fafc;border-radius:var(--radius-sm);margin-bottom:24px;">
            <input asp-for="IdentityVerified" type="checkbox" style="width:20px;height:20px;accent-color:var(--color-primary);flex-shrink:0;" />
            <div>
                <div style="font-weight:600;font-size:0.92rem;color:var(--color-text-main);">Identity Verified</div>
                <div style="font-size:0.8rem;color:var(--color-text-muted);">Identity document has been verified</div>
            </div>
        </div>
        <div style="margin-bottom:20px;">
            <label asp-for="Balance" style="display:block;font-size:0.82rem;font-weight:600;color:var(--color-text-muted);margin-bottom:6px;">
                Balance
            </label>
            <input asp-for="Balance" type="number" step="0.01"
                   style="width:100%;padding:10px 14px;border:1px solid var(--color-border);border-radius:var(--radius-sm);" />
        </div>

        <div style="display:flex;gap:12px;">
            <button type="submit" style="padding:10px 24px;background:var(--color-primary);color:#fff;border:none;border-radius:var(--radius-sm);font-weight:600;cursor:pointer;font-size:0.9rem;">Save Changes</button>
            <a asp-action="Index" style="padding:10px 24px;border:1px solid var(--color-border);color:var(--color-text-muted);border-radius:var(--radius-sm);font-weight:600;font-size:0.9rem;">Cancel</a>
        </div>
    </form>
</div>
