@model IEnumerable<eHoteloo.Models.Room>
@{
    Layout = "/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Rooms";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers


<div class="page-header">
    <h1>Rooms Management</h1>
    <a asp-action="Create" style="display:inline-flex;align-items:center;gap:6px;padding:10px 20px;background:var(--color-primary);color:#fff;border-radius:var(--radius-sm);font-size:0.85rem;font-weight:600;">
        <span class="material-symbols-outlined" style="font-size:18px;">add</span> Add Room
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div style="background:#fee2e2;color:#b91c1c;padding:12px 16px;border-radius:var(--radius-sm);margin-bottom:20px;font-size:0.88rem;font-weight:500;">
        @TempData["Error"]
    </div>
}

<div class="table-card">
    <div class="table-wrapper">
        <table>
            <thead>
                <tr>
                    <th>Room #</th>
                    <th>Type</th>
                    <th>Price / Day</th>
                    <th>Status</th>
                    <th>Created</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var room in Model)
                {
                    <tr>
                        <td class="td-mono">@room.RoomNumber</td>
                        <td>@room.RoomType</td>
                        <td style="font-weight:700;">$@room.PricePerDay</td>
                        <td>
                            @if (room.IsActive)
                            {
                                <span class="badge badge-green">Active</span>
                            }
                            else
                            {
                                <span class="badge badge-gray">Inactive</span>
                            }
                        </td>
                        <td class="td-muted">@room.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td style="text-align:right;">
                            <div style="display:inline-flex;gap:8px;">
                                <a asp-action="Details" asp-route-id="@room.Id" title="Details" style="color:var(--color-primary);padding:6px;border-radius:6px;">
                                    <span class="material-symbols-outlined" style="font-size:20px;">visibility</span>
                                </a>
                                <a asp-action="Edit" asp-route-id="@room.Id" title="Edit" style="color:#f59e0b;padding:6px;border-radius:6px;">
                                    <span class="material-symbols-outlined" style="font-size:20px;">edit</span>
                                </a>
                                <a asp-action="Delete" asp-route-id="@room.Id" title="Delete" style="color:#ef4444;padding:6px;border-radius:6px;">
                                    <span class="material-symbols-outlined" style="font-size:20px;">delete</span>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>