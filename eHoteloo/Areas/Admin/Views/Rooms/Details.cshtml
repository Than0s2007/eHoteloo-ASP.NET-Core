@using eHoteloo.Models
@model eHoteloo.Models.Room
@{
    Layout = "/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Room Details";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<div class="page-header">
    <div style="display:flex;align-items:center;gap:12px;">
        <a asp-action="Index" style="color:var(--color-text-muted);">
            <span class="material-symbols-outlined">arrow_back</span>
        </a>
        <h1>Room @Model.RoomNumber</h1>
    </div>
    <a asp-action="Edit" asp-route-id="@Model.Id" style="padding:10px 20px;background:#f59e0b;color:#fff;border-radius:var(--radius-sm);font-weight:600;font-size:0.85rem;">
        Edit Room
    </a>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">
    <!-- Room Info -->
    <div class="table-card" style="padding:24px;">
        <h3 style="font-size:1rem;font-weight:700;margin-bottom:20px;color:var(--color-text-main);">Room Information</h3>
        <div style="display:flex;flex-direction:column;gap:14px;font-size:0.9rem;">
            <div style="display:flex;justify-content:space-between;border-bottom:1px solid var(--color-border);padding-bottom:10px;">
                <span class="td-muted">Room Number</span>
                <span style="font-weight:600;">@Model.RoomNumber</span>
            </div>
            <div style="display:flex;justify-content:space-between;border-bottom:1px solid var(--color-border);padding-bottom:10px;">
                <span class="td-muted">Type</span>
                <span style="font-weight:600;">@Model.RoomType</span>
            </div>
            <div style="display:flex;justify-content:space-between;border-bottom:1px solid var(--color-border);padding-bottom:10px;">
                <span class="td-muted">Price Per Day</span>
                <span style="font-weight:700;color:#15803d;">$@Model.PricePerDay</span>
            </div>
            <div style="display:flex;justify-content:space-between;border-bottom:1px solid var(--color-border);padding-bottom:10px;">
                <span class="td-muted">Status</span>
                <span>
                    @if (Model.IsActive)
                    {
                        <span class="badge badge-green">Active</span>
                    }
                    else
                    {
                        <span class="badge badge-gray">Inactive</span>
                    }
                </span>
            </div>
            <div style="display:flex;justify-content:space-between;border-bottom:1px solid var(--color-border);padding-bottom:10px;">
                <span class="td-muted">Created</span>
                <span style="font-weight:500;">@Model.CreatedAt.ToString("dd MMM yyyy")</span>
            </div>
            <div>
                <span class="td-muted">Description</span>
                <p style="margin-top:6px;color:var(--color-text-main);line-height:1.5;">@(Model.Description ?? "No description available.")</p>
            </div>
        </div>
    </div>

    <!-- Room Images -->
    <div class="table-card" style="padding:24px;margin-top:20px;">
        <h3 style="font-size:1rem;font-weight:700;margin-bottom:20px;color:var(--color-text-main);">
            Room Images
        </h3>

        @if (Model.Images != null && Model.Images.Any())
        {
            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:12px;">
                @foreach (var img in Model.Images)
                {
                    <div style="border:1px solid var(--color-border);border-radius:var(--radius-sm);overflow:hidden;">
                        <img src="@img.ImagePath"
                             style="width:100%;height:120px;object-fit:cover;" />
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state" style="padding:40px 20px;">
                <span class="material-symbols-outlined">image_not_supported</span>
                <p>No images available</p>
            </div>
        }
    </div>

    <!-- Booking History -->
    <div class="table-card" style="padding:24px;">
        <h3 style="font-size:1rem;font-weight:700;margin-bottom:20px;color:var(--color-text-main);">Booking History</h3>
        @if (Model.Bookings?.Any() == true)
        {
            <div style="display:flex;flex-direction:column;gap:12px;">
                @foreach (var booking in Model.Bookings)
                {
                    <div style="border:1px solid var(--color-border);border-radius:var(--radius-sm);padding:14px;">
                        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">
                            <span class="td-mono">@booking.BookingNumber</span>
                            <span class="badge @(booking.Status == BookingStatus.Confirmed ? "badge-green" : booking.Status == BookingStatus.Pending ? "badge-yellow" : "badge-gray")">@booking.Status</span>
                        </div>
                        <div style="font-size:0.82rem;color:var(--color-text-muted);margin-bottom:4px;">@booking.User?.Email</div>
                        <div style="font-size:0.78rem;color:var(--color-text-light);">
                            @booking.CheckIn.ToString("dd MMM") - @booking.CheckOut.ToString("dd MMM yyyy")
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state" style="padding:40px 20px;">
                <span class="material-symbols-outlined">event_busy</span>
                <p>No bookings yet</p>
            </div>
        }
    </div>
</div>